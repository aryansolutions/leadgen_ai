[Unit]
Description=LeadFlow Node.js API
Documentation=https://nodejs.org/
After=network.target
Wants=network.target

[Service]
Type=simple
User=leadflow
Group=leadflow
WorkingDirectory=/opt/leadflow/server
EnvironmentFile=/etc/leadflow/server.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/leadflow/server/src/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/leadflow/server

[Install]
WantedBy=multi-user.target
