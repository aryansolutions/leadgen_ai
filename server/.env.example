NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Local development: install PostgreSQL directly and create a database named leadflow.
# Production: use the private Amazon RDS endpoint and enable SSL verification.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/leadflow
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_PATH=

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Calling is disabled until a real Exotel account, approved flow and verified
# webhook configuration are supplied.
CALLING_ENABLED=false
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_SECRET=
