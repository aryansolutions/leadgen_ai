
# LeadFlow environment template
# Copy values into the appropriate environment files.
# NEVER commit real API keys, passwords or secrets.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/leadflow
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_PATH=

# Authentication
JWT_SECRET=replace_with_random_secret_at_least_32_characters
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=60

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Exotel
CALLING_ENABLED=false
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_SECRET=

# Sarvam AI
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=deepseek-v4.1-flash-1017
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SAMPLE_RATE=8000
